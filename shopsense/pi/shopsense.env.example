# /etc/shopsense.env  (sudo install -m 640 -o root -g shopsense shopsense.env.example /etc/shopsense.env)
# API 키가 들어가므로 다른 사용자가 읽지 못하게 권한 640 유지

# 필수
SERVER_URL=http://203.255.81.72:10021
API_KEY=
SITE_ID=1

# 선택 (기본값)
#INTERVAL_SEC=10
#TRIG_PIN=23            # BCM
#ECHO_PIN=24            # BCM, 5V 에코 → 분압 필수
#SAMPLES=5
#MIN_VALID_SAMPLES=3    # 5회 중 유효 측정이 이보다 적으면 distance_cm=null
#MIN_CM=20              # JSN-SR04T 블라인드 존
#MAX_CM=600
#QUEUE_PATH=/var/lib/shopsense/queue.db
#MAX_QUEUE=259200       # 10초 주기 30일치
#BATCHES_PER_CYCLE=3    # 주기마다 최대 3000건까지 밀린 데이터 재전송
#HTTP_TIMEOUT=5
#NTP_WAIT_SEC=120
