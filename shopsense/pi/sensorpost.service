# /etc/systemd/system/sensorpost.service
# 대학가 가게 침수 실증: JSN-SR04T 수위센서 → 서버 전송
#
# 설치 절차는 shopsense/README.md의 "라즈베리파이 클라이언트" 참고. 요약:
#   sudo cp sensorpost.service /etc/systemd/system/
#   sudo systemctl enable --now systemd-time-wait-sync   # NTP 동기화 전에는 시작하지 않도록
#   sudo systemctl daemon-reload && sudo systemctl enable --now sensorpost
#   journalctl -u sensorpost -f

[Unit]
Description=Shopsense water level sensor uploader (JSN-SR04T)
# time-sync.target은 systemd-time-wait-sync가 켜져 있어야 실제로 NTP 동기화를 기다린다
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=simple
User=shopsense
Group=shopsense
# /dev/gpiochip* 접근
SupplementaryGroups=gpio
ExecStart=/usr/bin/python3 /opt/shopsense/sensor_post.py
# /var/lib/shopsense (미전송 큐) 를 shopsense 소유로 만들어 준다. 재부팅 후에도 유지된다.
StateDirectory=shopsense
Restart=always
RestartSec=10

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
# GPIO 장치를 써야 하므로 PrivateDevices는 켜지 않는다

[Install]
WantedBy=multi-user.target
