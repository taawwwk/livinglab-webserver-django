DEBUG=False
DJANGO_SECRET_KEY=your-secret-key-change-in-production

DB_NAME=livinglab_sensor
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# 오픈소스 실습: 라즈베리파이와 공유하는 BLE 패킷 HMAC 키 (docker-compose가 필수로 요구)
OPENSRC_HMAC_KEY=change-me
OPENSRC_TAG_LEN=8

# 대학가 가게 침수 실증: 수위센서 API 키. 콤마로 여러 개 가능. 생성 예:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SHOP_API_KEYS=
# POST /api/shop/readings/ API 키당 허용 횟수 (기본 60/min)
SHOP_POST_RATE=60/min
